   "source": [
    "#### Insertion Sort"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "2ade745c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[2, 3, 4, 8, 9]\n"
     ]
    }
   ],
   "source": [
    "def insertion_sort(arr):\n",
    "    for i in range(1,len(arr)):\n",
    "        \n",
    "        j = i\n",
    "        while j > 0 and arr[j] < arr[j-1]:\n",
    "            arr[j],arr[j-1] = arr[j-1],arr[j]\n",
    "            j -= 1\n",
    "    return arr\n",
    "\n",
    "arr = [8,9,2,4,3]\n",
    "arr = insertion_sort(arr)\n",
    "print(arr)"
   ]
  },
